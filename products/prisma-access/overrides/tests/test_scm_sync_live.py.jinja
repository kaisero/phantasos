        assert tag.absent(Tags(name=name, folder=folder)).action == "deleted"
        assert not tag.absent(Tags(name=name, folder=folder)).changed
        assert tag.fetch(name=name, folder=folder) is None
    finally:
        leftover = tag.fetch(name=name, folder=folder)
        if leftover is not None:
            tag.delete(id=leftover.id)


@pytest.fixture()
def bgp_routing(request):
    client = {{ package }}.Client(configuration_from_env())
    return client.deployment_services.bgp_routing


def test_bgp_routing_singleton_is_nondestructive(bgp_routing):
    """Live proof of the singleton leg — fetch(via get) -> diff -> no-op, check_mode
    prediction, and absent() rejection. STRICTLY NON-DESTRUCTIVE: it never persists a
    change to this global tenant config. It re-applies the CURRENT state (a no-op),
    predicts a hypothetical change in check_mode (no write), and asserts the server
    value is byte-identical before and after."""
    # 1) The singleton always exists: fetch drives FETCH["get"] -> res.get().
    current = bgp_routing.fetch()
    assert current is not None
    before = current.model_dump(by_alias=True, mode="json")

    # 2) Re-apply the FETCHED object verbatim as desired -> diff(current, current) is
    #    empty -> no-op that never reaches the mutate leg (writes nothing). This is the
    #    load-bearing singleton proof: fetch(via get) -> diff -> unchanged.
    r = bgp_routing.apply(current)
    assert not r.changed and r.action == "unchanged", r.diff.changes

    # 3) check_mode predicts a hypothetical flip WITHOUT writing. model_copy keeps every
    #    other field (incl. the oneOf routing_preference) intact, so the ONLY predicted
    #    change is the flipped boolean.
    flipped = current.model_copy(
        update={"withdraw_static_route": not current.withdraw_static_route}
    )
    r = bgp_routing.apply(flipped, check_mode=True)
    assert r.changed and r.action == "updated"
    assert set(r.diff.changes) == {"withdraw_static_route"}

    # 4) absent() is not a singleton operation -> raises (no delete lifecycle).
    with pytest.raises(AbsentNotSupported):
        bgp_routing.absent(current)

    # 5) Confirm the server-side blob is byte-identical -> nothing was persisted.
    after = bgp_routing.fetch().model_dump(by_alias=True, mode="json")
    assert after == before, "singleton global config must be unchanged"


def test_list_scan_pages_past_first_page(address):
    """F8 live proof: with offset pagination declared, `list(all_pages=True)` walks
    every page. Create 3 uniquely-prefixed addresses, list with a page size of 2 —
    so the 3rd is only reachable on page 2 — and assert all 3 come back and that
    `fetch` (which drives list_scan under the hood) finds the 3rd."""
    folder = "Shared"
    prefix = f"phx-page-{uuid.uuid4().hex[:8]}"
    names = [f"{prefix}-{i}" for i in range(3)]
    try:
        for i, nm in enumerate(names):
            address.apply(Addresses(name=nm, folder=folder,
                                    ip_netmask=f"10.20.{i}.0/24"))
        # A page size of 2 forces a second page for the 3-object prefix. Filter the
        # full (paginated) listing down to our prefix so co-tenant objects don't skew
        # the count.
        page = address.list(folder=folder, limit=2, all_pages=True)
        got = {a.name for a in page.data if a.name.startswith(prefix)}
        assert got == set(names), f"pagination lost objects: {sorted(got)}"
        # The 3rd object is only reachable past page 1 — fetch must still find it.
        third = address.fetch(name=names[2], folder=folder)
        assert third is not None and third.name == names[2]
    finally:
        for nm in names:
            leftover = address.fetch(name=nm, folder=folder)
            if leftover is not None:
                address.delete(id=leftover.id)


def test_from_access_token_provider_consulted_per_request():
    """Task 3.1 live seam: a caller-owned token source (Callable) drives a Client
    with no client_secret/scope wired into it, and the provider is pulled PER
    REQUEST (the prototype's n=14 observation, minimized to two authenticated
    reads). A bare str token performs one authenticated list."""
    tm = TokenManager(
        os.environ["CLIENT_ID"], os.environ["CLIENT_SECRET"], os.environ["SCOPE"]
    )
    pulls = {"n": 0}

    def counting_provider() -> str:
        pulls["n"] += 1
        return tm.token()

    # Callable path: two real reads -> provider consulted at least twice.
    client = {{ package }}.Client.from_access_token(counting_provider)
    client.objects.address.list(folder="Shared", limit=1)
    client.objects.address.list(folder="Shared", limit=1)
    assert pulls["n"] >= 2, pulls

    # str path: normalized to a one-shot provider; one authenticated list succeeds.
    token = tm.token()
    str_client = {{ package }}.Client.from_access_token(token)
    page = str_client.objects.address.list(folder="Shared", limit=1)
    assert page is not None
