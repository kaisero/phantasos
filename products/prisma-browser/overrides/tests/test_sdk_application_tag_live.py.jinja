"""Live CRUD round-trip for {{ package }} application tags.

Application tags are a preview feature: the SDK sends the
`x-prisma-browser-preview` header by default (sdk.yml `default_headers`), so
this suite also proves the header reaches a live tenant.

Skips (never fails) when live credentials are absent, so offline runs and
credential-less contributors are unaffected.
"""

import os
import uuid

import pytest

from {{ package }}.exceptions import NotFoundException
from {{ package }}.extras.facade import Client
from {{ package }}.models.tag_input import TagInput

_REQUIRED_ENV = ("CLIENT_ID", "CLIENT_SECRET", "SCOPE")
_PREFIX = "phx-harness-"

pytestmark = pytest.mark.skipif(
    any(not os.environ.get(var) for var in _REQUIRED_ENV),
    reason="live tenant credentials not set: " + ", ".join(_REQUIRED_ENV),
)


@pytest.fixture()
def client():
    c = Client.from_env()
    yield c
    c.close()


@pytest.fixture()
def created_ids(client):
    """Cleanup net, registered BEFORE any tag is created.

    Teardown deletes every tracked id, then sweeps the tenant for leftovers
    carrying our prefix (leaks from crashed earlier runs).
    """
    ids = []
    yield ids
    for tag_id in ids:
        try:
            client.application_tag.delete(tag_id)
        except NotFoundException:
            pass  # already deleted by the test body — the happy path
    page = client.application_tag.list(limit=100)
    for tag in page.data or []:
        if tag.name.startswith(_PREFIX):
            try:
                client.application_tag.delete(tag.id)
            except NotFoundException:
                pass


def test_application_tag_crud_round_trip(client, created_ids):
    name = _PREFIX + uuid.uuid4().hex[:12]

    created = client.application_tag.create(body=TagInput(name=name))
    assert created.id, "create returned no id"
    created_ids.append(created.id)

    got = client.application_tag.get(created.id)
    assert got.id == created.id
    assert got.name == name

    renamed = name + "-r"
    client.application_tag.replace(created.id, body=TagInput(name=renamed))
    assert client.application_tag.get(created.id).name == renamed

    client.application_tag.delete(created.id)
    with pytest.raises(NotFoundException):
        client.application_tag.get(created.id)
