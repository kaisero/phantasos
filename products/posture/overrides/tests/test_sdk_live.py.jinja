"""Live reachability + auth check for {{ package }}.

Proves the generated SDK AUTHENTICATES and reaches the posture API:

- `test_get_by_id_reaches_posture` fetches a sentinel id and asserts the API maps
  it to `NotFoundException` (404). This passes on any tenant authorized for posture
  ITEM operations. A 401 means the SDK is not attaching the bearer token (the
  injected security scheme regressed) — a HARD FAILURE. A 403 means the account is
  not authorized for posture item reads — skipped (environmental).
- `test_list_offset_pagination` exercises the collection LIST + offset pagination
  when the tenant is permitted to list (HTTP 200); a 403 on the collection endpoint
  (a separate, list-specific authz/license gate) is skipped.

Skips entirely when live credentials are absent (offline / credential-less runs).

NOTE: a full create -> read -> update -> delete oracle (the frozen
`test_sdk_crud_live.py`) requires a posture-entitled tenant with list+write
permission and should be authored once one is available.
"""

import os
import uuid

import pytest

from {{ package }}.exceptions import (
    ForbiddenException,
    NotFoundException,
    UnauthorizedException,
)
from {{ package }}.extras.facade import Client

_REQUIRED_ENV = ("CLIENT_ID", "CLIENT_SECRET", "SCOPE")

pytestmark = pytest.mark.skipif(
    any(not os.environ.get(var) for var in _REQUIRED_ENV),
    reason="live tenant credentials not set: " + ", ".join(_REQUIRED_ENV),
)


@pytest.fixture()
def client():
    c = Client.from_env()
    yield c
    c.close()


def test_get_by_id_reaches_posture(client):
    """Auth + reachability: a sentinel id must come back as 404 NotFound.

    A 401 here means the bearer token is not being attached (security scheme
    missing/regressed in the preprocess hook) — fail loudly.
    """
    sentinel = "phx-harness-nonexistent-" + uuid.uuid4().hex[:12]
    try:
        with pytest.raises(NotFoundException):
            client.posture_checks.get_posture_checks_by_id(sentinel)
    except UnauthorizedException:
        pytest.fail(
            "get_posture_checks_by_id returned 401 — the SDK is not attaching the "
            "bearer token (security scheme missing/regressed in the preprocess hook)"
        )
    except ForbiddenException:
        pytest.skip("account not authorized for posture item reads (403)")


def test_list_offset_pagination(client):
    """List + offset pagination when the tenant may list the collection."""
    try:
        page = client.posture_checks.list_posture_checks(limit=5)
    except UnauthorizedException:
        pytest.fail("401 — bearer token not attached")
    except ForbiddenException:
        pytest.skip("account not permitted to list posture checks (403, list-specific)")

    assert page.data is not None and isinstance(page.data, list)
    assert page.limit is not None  # offset-pagination envelope field
    items = list(client.paginate(client.posture_checks.list_posture_checks))
    if items:
        got = client.posture_checks.get_posture_checks_by_id(items[0].id)
        assert got.id == items[0].id
