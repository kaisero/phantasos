{% if federated | default(false) %}"""Runtime live smoke for the federated {{ package }} distribution.

SCOPE — auth + base-path + region WIRING, per sub-package. One real authenticated
collection read against every sub in ``_SUBPACKAGES`` proves its handle is wired:
the bearer is attached, the base-path resolves, and any required region header is
applied. It is NOT a per-object correctness check — the functional proof is the
CRUD oracle (``test_scm_crud_live.py``). A ``404``/``401``/``424`` means the wiring
is wrong (base-path / auth / region header), so those FAIL; any other status passes
(the request reached the tenant). Transport/network errors SKIP, never fail.

Probe per sub: a baked ``live_smoke`` override if present (``skip`` -> skip; ``$ENV``
arg values resolved here at runtime), else AUTO-PICK the first name-sorted object
with a ZERO-ARG ``list`` collection (``requires == []``) and call it zero-arg. A sub
with no such list and no override FAILS clearly — never a pre-HTTP error that would
bypass the status rule. Skips (never fails) without live credentials, so offline
runs and credential-less contributors are unaffected. Auto-collected by
``nox -s live`` via ``glob("tests/test_*_live.py")``.
"""

from __future__ import annotations

import importlib
import os
import socket
import traceback

import pytest
from pydantic import ValidationError

import {{ package }} as _sdk
from {{ package }}._runtime.exceptions import ApiException

try:  # urllib3 transport failures escape ApiException — skip, don't fail.
    from urllib3.exceptions import HTTPError as _TransportError
except ImportError:  # pragma: no cover
    _TransportError = ()  # type: ignore[assignment]

# Baked live_smoke overrides (sub slug -> probe dict). $ENV arg values are RAW here
# and resolved at runtime by _resolve_env; absent subs are auto-probed.
_LIVE_SMOKE: dict[str, dict] = {{ live_smoke_literal }}

# Auth creds + any required region header. Without these the composer raises at
# construction/first-access (a RuntimeError, not an HTTP error), so the smoke would
# ERROR instead of skipping — guard them all here so it cleanly SKIPS.
_REQUIRED_ENV = {{ live_required_env_literal }}
_FAIL_STATUSES = {404, 401, 424}
_TIMEOUT = 30  # seconds; socket-level cap so a hung tenant cannot stall the suite

pytestmark = pytest.mark.skipif(
    any(not os.environ.get(var) for var in _REQUIRED_ENV),
    reason="live credentials/region not set: " + ", ".join(_REQUIRED_ENV),
)


def _resolve_env(value: str) -> str:
    """Resolve a ``$ENV`` reference to its environment value (raw passthrough else).

    Skips (rather than empty-string) when the var is unset: a baked ``$WIDGET_ID``
    with no value would otherwise probe a bogus id and FAIL on the resulting 404,
    misreporting a wiring defect."""
    if isinstance(value, str) and value.startswith("$"):
        name = value[1:]
        if name not in os.environ:
            pytest.skip(f"live_smoke arg env ${name} is unset")
        return os.environ[name]
    return value


def _wrappers(slug: str) -> dict:
    """The sub's ``obj -> (wrapper_cls, api_attr)`` registry (the ``_WRAPPERS`` seam
    the auto-pick reads ``_bindings`` from)."""
    return importlib.import_module(f"{{ package }}.{slug}.extras.facade")._WRAPPERS


def _auto_object(wrappers: dict) -> str | None:
    """First name-sorted object with a ZERO-ARG ``list`` binding (``requires == []``).

    Filtering on ``requires == []`` and calling it zero-arg is deliberate: a
    missing-arg pick raises ``ValueError``/``TypeError`` BEFORE any HTTP call and
    would bypass the status rule (a green no-op)."""
    for name in sorted(wrappers):
        wrapper_cls = wrappers[name][0]
        for binding in wrapper_cls._bindings.get("list", []):
            if binding["requires"] == []:
                return name
    return None


def _resolve(slug: str) -> tuple[str, str, dict]:
    """Return ``(object, verb, kwargs)`` for the sub, or raise ``pytest.skip`` /
    ``pytest.fail`` — never a pre-HTTP ``ValueError``/``TypeError``."""
    wrappers = _wrappers(slug)
    probe = _LIVE_SMOKE.get(slug)
    if probe is not None:
        if probe.get("skip"):
            pytest.skip(f"{slug}: live_smoke override marks skip")
        obj = probe.get("object") or _auto_object(wrappers)
        if obj is None:
            pytest.fail(f"{slug}: live_smoke override has no object and no zero-arg list")
        kwargs = {k: _resolve_env(v) for k, v in (probe.get("args") or {}).items()}
        return obj, probe.get("verb") or "list", kwargs
    obj = _auto_object(wrappers)
    if obj is None:
        pytest.fail(
            f"{slug}: no zero-arg list collection to probe and no live_smoke override"
        )
    return obj, "list", {}


@pytest.fixture(autouse=True, scope="module")
def _bound_transport_timeout():
    """Bound urllib3 connect/read so a hung tenant cannot stall the suite. The typed
    wrapper verb takes no per-call timeout and ``pytest-timeout`` isn't installed, so
    cap the socket default for this module (restored on teardown)."""
    previous = socket.getdefaulttimeout()
    socket.setdefaulttimeout(_TIMEOUT)
    try:
        yield
    finally:
        socket.setdefaulttimeout(previous)


def _reached_server(exc: BaseException) -> bool:
    """True if ``exc`` was raised while DESERIALIZING a response — i.e. the request
    reached the tenant. A pydantic error on the response path means the body DID
    arrive but the (often over-strict / wrong-shaped) generated model couldn't parse
    it: that is a model-fidelity issue (``test_scm_crud_live.py``'s job), NOT a wiring
    defect — auth/base-path/region all worked. A PRE-HTTP arg-validation error (a bad
    probe/override) has no ``response_deserialize`` frame, so it is re-raised and fails
    loudly instead of masquerading as a wiring pass."""
    return any(
        frame.name == "response_deserialize"
        for frame in traceback.extract_tb(exc.__traceback__)
    )


@pytest.mark.parametrize("slug", sorted(_sdk._SUBPACKAGES))
def test_subpackage_wiring_resolves(slug: str) -> None:
    """One real authenticated read per sub proves its auth/base-path/region wiring."""
    obj, verb, kwargs = _resolve(slug)
    client = _sdk.Client.from_env()
    method = getattr(getattr(getattr(client, slug), obj), verb)
    try:
        method(**kwargs)  # typed wrapper verb: only its own params, no per-call timeout
    except ApiException as exc:
        if exc.status in _FAIL_STATUSES:
            pytest.fail(
                f"{slug}.{obj}.{verb}: {exc.status} — wiring failed "
                "(base-path/auth/region). See test_scm_crud_live.py for the "
                "functional CRUD proof."
            )
    except ValidationError as exc:  # response arrived but the model couldn't parse it
        if not _reached_server(exc):  # pre-HTTP arg-validation = bad probe → fail loud
            raise
    except _TransportError as exc:  # network/transport, not a wiring defect
        pytest.skip(f"{slug}.{obj}.{verb}: transport error ({exc})")
