[project]
name = "{{ distribution }}"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
    "typer>=0.12",
    "rich>=13",
    "pyyaml>=6",
    "{{ sdk_dependency }}",
]

[project.scripts]
{{ distribution }} = "{{ package }}.main:app"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
