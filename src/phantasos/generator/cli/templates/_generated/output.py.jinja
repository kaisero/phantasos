"""Render SDK results as Rich JSON (default), table, or YAML."""

from __future__ import annotations

import json
import sys
from typing import Any

import yaml
from rich.console import Console
from rich.table import Table

_console = Console()
_err_console = Console(stderr=True)


def _error_headline(data: Any) -> str | None:
    """Best-effort one-line message from common error-body shapes (schema-agnostic)."""
    if not isinstance(data, dict):
        return None
    # unwrap one level for common envelopes (e.g. PANW {"errorResponse": {...}})
    for wrapper in ("errorResponse", "error_response"):
        if isinstance(data.get(wrapper), dict):
            data = data[wrapper]
            break
    if isinstance(data.get("error"), dict):  # {"error": {"message": ...}}
        data = data["error"]
    for key in ("error", "message", "detail", "title", "description"):
        val = data.get(key)
        if isinstance(val, str) and val.strip():
            return val.strip()
    return None


def render_error(exc: Any) -> None:
    """Pretty-print an SDK/API error to stderr. HTTP errors (with .status) get a
    Rich status line + headline + parsed JSON body; other errors get a plain message.
    Schema-agnostic: uses only the universal ApiException interface (.status/.reason/.body)."""
    status = getattr(exc, "status", None)
    if status is None:
        # not an HTTP API error (e.g. pydantic ValidationError) — keep it simple
        print(f"error: {exc}", file=sys.stderr)
        return
    reason = getattr(exc, "reason", "") or ""
    body = getattr(exc, "body", None)
    if isinstance(body, (bytes, bytearray)):
        body = body.decode("utf-8", "replace")
    parsed: Any = None
    if isinstance(body, str) and body.strip():
        try:
            parsed = json.loads(body)
        except ValueError:
            parsed = None
    if parsed is None:  # fall back to the typed .data model if present
        data = getattr(exc, "data", None)
        if data is not None and hasattr(data, "model_dump"):
            try:
                parsed = data.model_dump(mode="json", by_alias=True, exclude_none=True)
            except Exception:  # noqa: BLE001 - never let error rendering crash
                parsed = None
    head = f"Error {status} {reason}".rstrip()
    headline = _error_headline(parsed)
    if headline:
        head = f"{head} — {headline}"   # em dash
    _err_console.print(f"[bold red]{head}[/]")
    if parsed is not None:
        _err_console.print_json(data=parsed)
    elif isinstance(body, str) and body.strip():
        _err_console.print(body.strip())


def _to_data(obj: Any) -> Any:
    if isinstance(obj, list):
        return [_to_data(o) for o in obj]
    if hasattr(obj, "model_dump"):
        return obj.model_dump(mode="json")
    if isinstance(obj, dict):
        return {k: _to_data(v) for k, v in obj.items()}
    if obj is None or isinstance(obj, (str, int, float, bool)):
        return obj
    return str(obj)  # never leak a Python object repr to the user


def render(result: Any, fmt: str = "json") -> None:
    if result is None:
        return  # empty success (e.g. delete / HTTP 204) — print nothing
    data = _to_data(result)
    if fmt == "yaml":
        print(yaml.safe_dump(data, sort_keys=False, default_flow_style=False), end="")
        return
    if fmt == "table":
        _render_table(data)
        return
    _console.print_json(data=data)  # default: Rich-formatted JSON


_VERB_COLORS = {"GET": "green", "POST": "blue", "PUT": "blue", "PATCH": "yellow", "DELETE": "red"}


def render_dry_run(method: str, url: str, body: Any = None) -> None:
    """Pretty-print the HTTP request a command WOULD send (no request performed)."""
    color = _VERB_COLORS.get(str(method).upper(), "cyan")
    _console.print("[dim]DRY RUN · no request sent[/]")
    _console.print(f"[bold {color}]{method}[/] {url}")
    if body in (None, "", b""):
        return
    data: Any = body
    if isinstance(data, (bytes, bytearray)):
        data = data.decode("utf-8", "replace")
    if isinstance(data, str):
        try:
            data = json.loads(data)
        except ValueError:
            _console.print(data)
            return
    _console.print_json(data=data)


def _render_table(data: Any) -> None:
    rows = data if isinstance(data, list) else [data]
    rows = [r for r in rows if isinstance(r, dict)]
    if not rows:
        _console.print(data)
        return
    keys: list[str] = []
    for pref in ("id", "name"):
        if pref in rows[0]:
            keys.append(pref)
    for k, v in rows[0].items():
        if k not in keys and not isinstance(v, (dict, list)):
            keys.append(k)
    table = Table(*keys)
    for r in rows:
        table.add_row(*[str(r.get(k, "")) for k in keys])
    _console.print(table)
