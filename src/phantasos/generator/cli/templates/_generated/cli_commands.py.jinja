cli_show_app = typer.Typer(no_args_is_help=True, help="CLI meta information.")


@cli_show_app.command("history")
def show_history(
    limit: int = typer.Option(20, "--limit", help="Entries to show (0 = all)."),
    entry: int | None = typer.Option(
        None, "--entry", help="Show ONE entry as full JSON (includes bodies if recorded)."
    ),
    pager: bool | None = typer.Option(
        None, "--pager/--no-pager",
        help="Page output taller than the terminal (default from config).",
        rich_help_panel="Common",
    ),
) -> None:
    """Show the command history (newest entries last)."""
    if entry is not None:
        e = _history.read_entry(entry)
        if e is None:
            _diag.fail(f"no history entry with id {entry}", code=2)
        _output._console.print_json(data=e)
        return
    entries, corrupt = _history.read_entries(limit)
    if corrupt:
        _diag.warning(f"skipped {corrupt} corrupt history line(s)")
    if not entries:
        _diag.info("history is empty")
        return
    table = Table("id", "date", "command", "status")
    for e in entries:
        # display timestamps to the minute (full ISO ts stays in the file/--entry)
        ts = str(e.get("ts", ""))[:16].replace("T", " ")
        table.add_row(
            str(e.get("id", "")), ts,
            str(e.get("command", "")), str(e.get("status", "")),
        )
    with _output.maybe_paged(pager):
        _output._console.print(table)


@cli_show_app.command("log")
def show_log(
    limit: int = typer.Option(20, "--limit", help="Entries to show (0 = all)."),
    level: str | None = typer.Option(
        None, "--level", help="Show this level and above "
        "(trace|debug|info|warning|error|critical)."
    ),
    as_json: bool = typer.Option(
        False, "--json", help="Print raw JSON log records (includes tracebacks)."
    ),
    follow: bool = typer.Option(
        False, "--follow", "-f",
        help="Stream new log lines as they arrive (Ctrl-C to stop)."
    ),
    pager: bool | None = typer.Option(
        None, "--pager/--no-pager",
        help="Page output taller than the terminal (ignored with --follow).",
        rich_help_panel="Common",
    ),
) -> None:
    """Show the CLI log (newest last) — rotating JSONL plus its .gz backups."""
    from . import config as _config
    from . import logging_setup as _log

    if level is not None and level.lower() not in _config._LOG_LEVELS:
        _diag.fail(
            f"unknown log level {level!r} "
            "(choose: trace, debug, info, warning, error, critical)",
            code=2,
        )
    records, corrupt = _log.read_log(limit=limit, min_level=level)
    if corrupt:
        _diag.warning(f"skipped {corrupt} corrupt log line(s)")
    if follow:
        _follow_log(records, level=level, as_json=as_json)
        return
    if not records:
        _diag.info("log is empty")
        return
    if as_json:
        with _output.maybe_paged(pager):
            for r in records:
                _output._console.print_json(data=r)
        return
    table = Table("time", "level", "logger", "message")
    for r in records:
        ts = str(r.get("ts", ""))[:16].replace("T", " ")
        msg = str(r.get("msg", ""))
        if r.get("exc"):
            msg += "  [dim](+traceback — use --json)[/dim]"
        table.add_row(ts, str(r.get("level", "")), str(r.get("logger", "")), msg)
    with _output.maybe_paged(pager):
        _output._console.print(table)


def _emit_log_line(r: dict, as_json: bool) -> None:
    if as_json:
        _output._console.print_json(data=r)
        return
    ts = str(r.get("ts", ""))[11:19]  # HH:MM:SS
    _output._console.print(
        f"{ts} {str(r.get('level', '')):<8} {r.get('msg', '')}", markup=False
    )


def _follow_log(records: list[dict], *, level: str | None, as_json: bool) -> None:
    # Minimal stub (Task 2): emit the snapshot and return. Task 3 adds the stream.
    for r in records:
        _emit_log_line(r, as_json)

