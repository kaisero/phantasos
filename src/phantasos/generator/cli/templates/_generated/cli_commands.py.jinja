"""`show cli` meta-object: CLI introspection (history; future: status, changelog)."""

from __future__ import annotations

{% if federated %}import difflib
from importlib.resources import files
from .spec import CliIR as _CliIR
{% endif %}import typer
from rich.table import Table

from . import diagnostics as _diag
from . import history as _history
from . import output as _output

cli_show_app = typer.Typer(no_args_is_help=True, help="CLI meta information.")


@cli_show_app.command("history")
def show_history(
    limit: int = typer.Option(20, "--limit", help="Entries to show (0 = all)."),
    entry: int | None = typer.Option(
        None, "--entry", help="Show ONE entry as full JSON (includes bodies if recorded)."
    ),
    pager: bool | None = typer.Option(
        None, "--pager/--no-pager",
        help="Page output taller than the terminal (default from config).",
        rich_help_panel="Common",
    ),
) -> None:
    """Show the command history (newest entries last)."""
    if entry is not None:
        e = _history.read_entry(entry)
        if e is None:
            _diag.fail(f"no history entry with id {entry}", code=2)
        _output._console.print_json(data=e)
        return
    entries, corrupt = _history.read_entries(limit)
    if corrupt:
        _diag.warning(f"skipped {corrupt} corrupt history line(s)")
    if not entries:
        _diag.info("history is empty")
        return
    table = Table("id", "date", "command", "status")
    for e in entries:
        # display timestamps to the minute (full ISO ts stays in the file/--entry)
        ts = str(e.get("ts", ""))[:16].replace("T", " ")
        table.add_row(
            str(e.get("id", "")), ts,
            str(e.get("command", "")), str(e.get("status", "")),
        )
    with _output.maybe_paged(pager):
        _output._console.print(table)

{% if federated %}

def _object_index() -> dict:
    """Build object → {subpackage, verbs, description} index from ir.json."""
    # ponytail: re-reads ir.json per call; cheap (local file, <1 ms); add an
    # lru_cache here if profiling shows it matters in practice.
    text = files(__package__).joinpath("ir.json").read_text(encoding="utf-8")
    ir = _CliIR.model_validate_json(text)
    index: dict = {}
    for c in ir.commands:
        if c.object not in index:
            sub = (c.subpackage or "").replace("_", "-")
            index[c.object] = {
                "subpackage": sub,
                "verbs": [],
                "description": c.summary or c.description,
            }
        if c.verb not in index[c.object]["verbs"]:
            index[c.object]["verbs"].append(c.verb)
    return index


def which_object(
    object_name: str = typer.Argument(..., help="Object name to locate."),
) -> None:
    """Locate which sub-package provides an object and what verbs it supports."""
    index = _object_index()
    if object_name in index:
        entry = index[object_name]
        verbs = ", ".join(entry["verbs"])
        line = f"{object_name} — {entry['subpackage']} · {verbs}"
        if entry["description"]:
            line += f"  {entry['description']}"
        typer.echo(line)
    else:
        matches = difflib.get_close_matches(object_name, list(index), n=3, cutoff=0.6)
        msg = f"unknown object '{object_name}'."
        if matches:
            msg += f" Did you mean: {', '.join(matches)}?"
        typer.echo(msg, err=True)
        raise typer.Exit(code=1)
