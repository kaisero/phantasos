@functools.lru_cache(maxsize=1)
def _ir() -> CliIR:
    text = files(__package__).joinpath("ir.json").read_text(encoding="utf-8")
    return CliIR.model_validate_json(text)


def _commands() -> dict[str, Command]:
    return {c.key: c for c in _ir().commands}


def _facade_from_env(**kw: Any) -> Any:
    """Tiny seam over the facade's ``Client.from_env`` so tests can monkeypatch
    the credential threading without standing up a real client."""
    return importlib.import_module(_ir().facade_module).Client.from_env(**kw)
{% if has_env %}

# Per-invocation environment selection. A contextvar (not a module global) so the
# selection is scoped to the running command and never leaks across CliRunner
# invocations sharing the imported module.
_SELECTED_ENV: contextvars.ContextVar[str | None] = contextvars.ContextVar(
    "selected_env", default=None
)


def select_environment(name: str | None) -> None:
    """Record the environment chosen by ``--environment/-e`` for this command."""
    _SELECTED_ENV.set(name)


def _selected_environment_source() -> tuple[str | None, str]:
    """The active environment and WHY, by precedence:
    -e flag (contextvar) > {{ env_prefix }}_ENVIRONMENT env var > default_environment.
    Source ∈ {"flag","env","default","none"}. Empty {{ env_prefix }}_ENVIRONMENT is
    treated as absent (falls through). Logs the winning source at DEBUG."""
    from . import config as _config

    flag = _SELECTED_ENV.get()
    if flag:
        name, source = flag, "flag"
    elif os.environ.get("{{ env_prefix }}_ENVIRONMENT"):
        name, source = os.environ["{{ env_prefix }}_ENVIRONMENT"], "env"
    else:
        d = _config.default_environment()
        name, source = (d, "default") if d else (None, "none")
    _config._ENV_LOG.debug("selected environment %r (source: %s)", name, source)
    return name, source


def _selected_environment() -> str | None:
    return _selected_environment_source()[0]
{% endif -%}
{% if ir.connection_fields %}


def _preflight_connection(cmd: Command) -> None:
    """Exit 2 if a connection field required for this command's sub-package is missing.

    A field is required for this invocation when field.required is True OR
    cmd.subpackage is in field.required_for. Resolution mirrors _client():
    exported env var > active-environment value (region lives in the env config).
    """
    from . import config as _config

    name = _selected_environment()
    eff = {e.env_var: e for e in _config.resolve_effective(name) if e.kind == "connection"}
    for f in _ir().connection_fields:
        needed = f.required or (
            cmd.subpackage is not None and cmd.subpackage in f.required_for
        )
        if not needed:
            continue
        # Value + env-var precedence come from the shared resolver (connection
        # fields use truthiness — an empty region header is treated as absent).
        val = eff[f.env].value if f.env in eff else None
        if not val:
            # f.flag is the field's `environment create --<flag>` spelling.
            flag = f.flag or f.name.split("-")[-1].lower()
            sub = cmd.subpackage
            if sub and sub in f.required_for:
                why = f"the '{sub}' sub-package requires {f.env}"
            else:
                why = f"{f.env} is required"
            headline = (
                f"environment '{name}' is missing {f.env}: {why}"
                if name
                else f"missing {f.env}: {why}"
            )
            _diag.fail(
                headline,
                code=2,
                hint=(
                    f"set {f.env} (env var or .env) "
                    f"or run 'environment create <name> --{flag} <value>'"
                ),
            )
{% endif %}


def _client(verbose: bool = False) -> Any:  # no lru_cache: one-shot CLI + keeps monkeypatch reliable
    try:
        from dotenv import find_dotenv, load_dotenv
        load_dotenv(find_dotenv(usecwd=True))  # loads ./.env (and parent dirs) into os.environ if present
    except ModuleNotFoundError:
        pass
{%- if has_env %}
    from . import config as _config

    # Resolve the active named environment (if any), then let presence-based env
    # vars override its fields per the locked precedence. NEVER use truthiness:
    # an exported-but-empty CLIENT_ID= must still win over the config value.
    name = _selected_environment()
    if name is not None and name not in _config._raw_environments():
        # An env was explicitly selected (-e / {{ env_prefix }}_ENVIRONMENT /
        # default_environment) but isn't defined — fail loudly rather than
        # silently falling back to ambient env-var auth (wrong-credentials risk).
        _diag.fail(
            f"unknown environment '{name}' (run 'environment show')",
            code=2,
        )
{%- endif %}
{%- if ir.credential_fields %}
    # Value + env-var-override precedence (presence, not truthiness) come from the
    # shared resolver. _client still owns the required-empty policy: a required
    # credential resolving to None OR "" is unusable (the SDK rejects empties with
    # `if not v`), so pre-empt the raw RuntimeError with a clean message here.
    overrides: dict[str, Any] = {}
    missing: list[str] = []
    _req = {f.name: f.required for f in _ir().credential_fields}  # required stays IR-driven
    for e in _config.resolve_effective(name):
        if e.kind != "credential":
            continue
        if e.value is not None:
            overrides[e.client_kwarg] = e.value
        if _req.get(e.name) and not e.value:
            missing.append(e.env_var)
    if missing:
        joined = ", ".join(missing)
        if name:
            headline = f"environment '{name}' is missing required credentials: {joined}"
        elif overrides:
            headline = f"missing required credentials: {joined}"
        else:
            headline = "no credentials configured"
        _diag.fail(
            headline,
            code=2,
            hint=(
                f"run 'environment create <name>' to save credentials, "
                f"or set {joined} (e.g. in a .env file)"
            ),
        )
{%- endif %}
{%- if ir.connection_fields %}
    # Connection headers: export each to its env var BEFORE building the client
    # (the SDK reads them from the environment; there is no kwarg path).
    # Precedence: exported env var > active-environment value (the env config).
    for e in _config.resolve_effective(name):
        if e.kind == "connection" and e.env_var not in os.environ and e.value is not None:
            os.environ[e.env_var] = e.value
{%- endif %}
{%- if ir.credential_fields %}
    try:
        return _facade_from_env(**overrides)
    except RuntimeError as exc:
        # Credentials are present but auth still failed (token endpoint down,
        # network error, rejected secret). Keep --verbose's traceback for debugging.
        if verbose:
            raise
        _diag.fail(f"authentication failed: {exc}", code=1)
{%- else %}
    return _facade_from_env()
{%- endif %}


def _models(cmd: Command) -> Any:
    # Federated: each sub-package ships its own `models` module
    # (`{pkg}.{sub}.models`) — there is NO top-level `{pkg}.models`. Single-spec
    # keeps the bare path. `_build_body` then `getattr`s the BARE body_model name.
    pkg = _ir().sdk_package
    if cmd.subpackage:
        return importlib.import_module(f"{pkg}.{cmd.subpackage}.models")
    return importlib.import_module(f"{pkg}.models")


def _sdk_exc(cmd: Command) -> type[BaseException]:
    # Federated: the SDK base exception lives under `_runtime` (the top-level package
    # has no `exceptions` module); single-spec keeps the bare `{pkg}.exceptions`.
    pkg = _ir().sdk_package
    mod_name = f"{pkg}._runtime.exceptions" if cmd.subpackage else f"{pkg}.exceptions"
    try:
        mod = importlib.import_module(mod_name)
    except ModuleNotFoundError:
        return Exception
    base = getattr(mod, "OpenApiException", None)
    return base if isinstance(base, type) else Exception


def _accepted_params(cmd: Command, sdk_method: str) -> set[str] | None:
    """Param names the bound wrapper method accepts, or None if undeterminable /
    **kwargs-tolerant (then nothing is dropped). Credential-free: inspects the
    facade's typed wrapper class, never an instantiated client. The wrapper verb
    accepts the clean param surface (e.g. ``sort``/``order``/``all_pages`` for a
    list), so cli.yml-injected defaults are filtered against it, not the raw
    ``*Api`` signature. Federated: the wrappers live on the SUB's facade
    (`{pkg}.{sub}.extras.facade`), not the top-level composing package."""
    try:
        if cmd.subpackage:
            facade = importlib.import_module(
                f"{_ir().sdk_package}.{cmd.subpackage}.extras.facade"
            )
        else:
            facade = importlib.import_module(_ir().facade_module)
        wrapper_cls = facade._WRAPPERS[cmd.sdk_resource][0]
        fn = getattr(wrapper_cls, sdk_method)
        sig = inspect.signature(fn)
    except Exception:
        # fail-open: dropping nothing preserves pre-feature behavior, and the
        # SDK's own @validate_call remains the backstop for bad kwargs
        return None
    params = sig.parameters.values()
    if any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params):
        return None
    return {p.name for p in params} - {"self"}


def _hooks() -> Any | None:
    try:
        return importlib.import_module("{{ package }}.hooks")
    except ModuleNotFoundError:
        return None


class InputError(Exception):
    """A user-supplied flag value could not be parsed. Carries optional structured
    fields rendered by the diagnostics facade; never a raw traceback."""

    def __init__(self, message: str, *, expected: str | None = None,
                 example: str | None = None, got: Any | None = None,
                 code: int = 2) -> None:
        super().__init__(message)
        self.message = message
        self.expected = expected
        self.example = example
        self.got = got
        self.code = code


_BOOL_TRUE = {"1", "true", "yes", "y", "on"}
_BOOL_FALSE = {"0", "false", "no", "n", "off"}


def _coerce(flag: Flag, value: Any) -> Any:
    if value is None:
        return None
    if flag.kind == "json" and isinstance(value, str):
        try:
            return json.loads(value)
        except json.JSONDecodeError as exc:
            raise InputError(f"{flag.name}: invalid JSON ({exc})", got=value) from exc
    if flag.py_type == "int" and isinstance(value, str):
        try:
            return int(value)
        except ValueError as exc:
            raise InputError(f"{flag.name}: invalid integer", got=value) from exc
    if flag.py_type == "bool" and isinstance(value, str):
        v = value.strip().lower()
        if v in _BOOL_TRUE:
            return True
        if v in _BOOL_FALSE:
            return False
        raise InputError(f"{flag.name}: invalid boolean (use true or false)", got=value)
    return value


def _fail_input(exc: InputError) -> NoReturn:
    _diag.fail(exc.message, code=exc.code,
               expected=exc.expected, example=exc.example,
               got=(repr(exc.got) if exc.got is not None else None))


_SUBVERB_PRIORITY = {
    "patch": 0, "put": 1, "create": 2, "update": 3, "delete": 4,
    "get": 5, "list": 6, "bulk_create": 7, "bulk_delete": 8,
}


def _pick_binding(cmd: Command, present: set[str]) -> MethodBinding:
    candidates = [b for b in cmd.bindings if set(b.requires) <= present]
    if not candidates:
        if cmd.get_by_id_only:
            # A `show` backed only by get-by-id (no list endpoint exists).
            # Reaching here means --id was omitted; say so precisely instead of
            # the generic no-match message.
            _diag.fail(
                f"'{cmd.verb} {cmd.object}' has no list operation",
                code=2,
                hint=(
                    f"fetch a single {cmd.object} by id, "
                    f"e.g. '{cmd.verb} {cmd.object} --id <id>'"
                ),
            )
        _diag.fail(f"no operation for '{cmd.key}' matches the given arguments", code=2)
    best_len = max(len(b.requires) for b in candidates)
    top = [b for b in candidates if len(b.requires) == best_len]
    return min(top, key=lambda b: (_SUBVERB_PRIORITY.get(b.sub_verb, 99), b.sdk_method))


def _strip_optional(ann: Any) -> Any:
    if typing.get_origin(ann) is typing.Union:
        args = [a for a in typing.get_args(ann) if a is not type(None)]
        if len(args) == 1:
            return args[0]
    return ann


def _placeholder(ann: Any) -> Any:
    return {str: "string", bool: False, int: 0, float: 0.0}.get(
        _strip_optional(ann), None
    )


def _skeleton(model: Any) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for name, f in model.model_fields.items():
        if name == "additional_properties" or not f.is_required():
            continue
        out[f.alias or name] = _placeholder(f.annotation)
    return out


def _registry_example(flag: Flag) -> str | None:
    if not flag.model_ref:
        return None
    from . import config as _config  # local import — the module's convention
    full = _config.log_level_int(_config.get().logging.level) <= 10  # debug or trace
    skel = synth_skeleton(_ir().models, flag.model_ref, full=full)
    return json.dumps(skel, separators=(",", ":"))


def _describe_json_field(model_cls: Any, param: str) -> tuple[str | None, str | None]:
    mf = getattr(model_cls, "model_fields", {}).get(param)
    if mf is None:
        return None, None
    ann = _strip_optional(mf.annotation)
    origin = typing.get_origin(ann)
    lo = hi = None
    for m in getattr(mf, "metadata", []):
        lo = getattr(m, "min_length", lo)
        hi = getattr(m, "max_length", hi)
    if origin in (list, set):
        inner = _strip_optional(typing.get_args(ann)[0])
        is_obj = hasattr(inner, "model_fields")
        shape = "array of objects" if is_obj else "array"
        if lo and hi:
            count = f" ({lo}–{hi} items)"
        elif hi:
            count = f" (max {hi} items)"
        elif lo:
            count = f" (min {lo} items)"
        else:
            count = ""
        ex = [_skeleton(inner)] if is_obj else [_placeholder(inner)]
        return f"a JSON {shape}{count}", json.dumps(ex)
    if hasattr(ann, "model_fields"):
        return "a JSON object", json.dumps(_skeleton(ann))
    return "a JSON object", json.dumps({"key": "value"})


def _build_body(binding: MethodBinding, body: dict[str, Any],
                flags: dict[str, Flag], models: Any,
                extra: dict[str, Any] | None = None) -> Any:
    model_cls = getattr(models, binding.body_model)
    parsed: dict[str, Any] = {}
    for k, v in body.items():
        if v is None:
            continue
        try:
            parsed[k] = _coerce(flags[k], v)
        except InputError as exc:
            fl = flags[k]
            if fl.kind == "json" and exc.expected is None:
                exp, live_ex = _describe_json_field(model_cls, k)
                exc.expected = exp
                reg = _registry_example(fl)
                # D11: registry skeleton for known models; anonymous json (no
                # model_ref → reg is None) keeps the live {"key": "value"} fallback.
                ex = reg if reg is not None else live_ex
                exc.example = f"{fl.name} '{ex}'" if ex else None
            raise
    if extra:
        parsed.update(extra)  # pre-resolved (e.g. variant discriminator); no coercion
    # PATCH semantics: use model_construct (no validation) so that only the
    # user-supplied fields are set.  SDKs that reuse the create model have required
    # fields, but PATCH must never enforce them — the server ignores absent fields.
    if binding.sub_verb == "patch":
        inner = model_cls.model_construct(**parsed)
    else:
        inner = model_cls(**parsed)
    if binding.body_wrapper:
        return getattr(models, binding.body_wrapper)(inner)
    return inner


def _dry_run(cmd: Command, binding: MethodBinding, kwargs: dict[str, Any]) -> None:
    """Print the HTTP request that would be sent, via the typed wrapper's
    ``_serialize`` seam (no request performed, no credentials needed). The
    wrapper selects the right backing op, renames ``body``/enum params to the
    raw surface, and delegates to the generated ``<method>_serialize`` — so the
    dry-run sees the exact request the live call would build. Falls back to a
    call reference if the wrapper lacks the serialize seam (test fakes)."""
    try:
        if cmd.subpackage:
            # Federated: build just this SUB's facade (credential-free) and navigate
            # to its object wrapper. The top-level package has no `api_client`/
            # `configuration` module and its composing `Client` wants credentials —
            # the per-sub facade serializes without either.
            sub = f"{_ir().sdk_package}.{cmd.subpackage}"
            sub_mod = importlib.import_module(sub)
            facade = importlib.import_module(f"{sub}.extras.facade")
            api_client = sub_mod.ApiClient(sub_mod.Configuration())
        else:
            pkg = _ir().sdk_package
            api_client_mod = importlib.import_module(f"{pkg}.api_client")
            config_mod = importlib.import_module(f"{pkg}.configuration")
            facade = importlib.import_module(_ir().facade_module)
            api_client = api_client_mod.ApiClient(config_mod.Configuration())
        client = facade.Client(api_client)
        api = getattr(client, cmd.sdk_resource)
        serialize = getattr(api, "_serialize", None)
        if serialize is None:
            raise AttributeError("wrapper has no _serialize seam")
        method, url, _headers, body, *_rest = serialize(binding.sdk_method, **kwargs)
    except Exception:  # dry-run must never fail hard
        print(f"DRY-RUN {cmd.key} -> {cmd.sdk_resource}.{binding.sdk_method}(...)")
        return
    _output.render_dry_run(method, url, body)


def _error_headline_for(exc: BaseException) -> str:
    """Same best-effort headline render_error shows: parsed-body first (via
    _diag._error_headline), then str(exc), then the exception type name.
    (python-pro review: deriving from str(exc) alone violates the spec and
    misses the actionable server message.)"""
    body = getattr(exc, "body", None)
    if isinstance(body, (bytes, bytearray)):
        body = body.decode("utf-8", "replace")
    if isinstance(body, str) and body.strip():
        try:
            headline = _diag._error_headline(json.loads(body))
        except ValueError:
            headline = None
        if headline:
            return headline[:300]
    text = str(exc).strip()
    return text.splitlines()[0][:300] if text else type(exc).__name__


def _history_entry(cmd: Command, binding: MethodBinding, status: str,
                   *, duration_ms: int | None = None,
                   exc: BaseException | None = None,
                   request_body: Any = None,
                   response: Any = None,
                   http: dict[str, str] | None = None) -> dict[str, Any]:
    entry: dict[str, Any] = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "command": shlex.join(sys.argv[1:]) if len(sys.argv) > 1 else cmd.key,
        "sdk_method": f"{cmd.sdk_resource}.{binding.sdk_method}",
        "status": status,
    }
    if http:
        uri = http.get("http_uri", "")
        entry["http_method"] = http.get("http_method", "")
        # the query string lives ONLY in http_params (no redundancy in the URI)
        entry["http_uri"] = uri.split("?", 1)[0]
        query = urlsplit(uri).query
        if query:
            # structured query params: single value -> str, repeated key -> list
            # (headers are deliberately NOT captured: they carry the auth token)
            params: dict[str, Any] = {}
            for k, v in parse_qsl(query):
                if k in params:
                    prev = params[k]
                    params[k] = [*prev, v] if isinstance(prev, list) else [prev, v]
                else:
                    params[k] = v
            entry["http_params"] = params
    if duration_ms is not None:
        entry["duration_ms"] = duration_ms
    if exc is not None:
        http_status = getattr(exc, "status", None)
        if http_status is not None:
            entry["http_status"] = http_status
        entry["error"] = _error_headline_for(exc)
    if _config_verbose():
        if request_body is not None:
            entry["request_body"] = _output._to_data(request_body)
        if response is not None:
            entry["response_body"] = _output._to_data(response)
    return entry


def _config_verbose() -> bool:
    from . import config as _config

    return _config.get().history.verbose


def run(key: str, *, path: dict[str, Any], body: dict[str, Any],
        query: dict[str, Any], output: str, paginate_all: bool,
        dry_run: bool, verbose: bool,
        columns: list[str] | None = None,
        quiet: bool = False,
        pager: bool | None = None) -> None:
    _diag.set_min_level(_diag.Level.ERROR if quiet else _diag.Level.INFO)
    cmd = _commands()[key]
    if columns:
        output = "table"  # --columns implies table rendering
    present = {k for k, v in path.items() if v is not None}
    if cmd.variant and cmd.variant_param:
        present.add(cmd.variant_param)
    binding = _pick_binding(cmd, present)

    path_flags = {f.param: f for f in cmd.path_params}
    query_flags = {f.param: f for f in cmd.query_flags}
    body_flags = {f.param: f for f in cmd.body_flags}

    kwargs: dict[str, Any] = {}
    try:
        for k, v in path.items():
            if v is not None:
                kwargs[k] = _coerce(path_flags[k], v)
        if cmd.variant and cmd.variant_param:
            kwargs[cmd.variant_param] = cmd.variant
        accepted = _accepted_params(cmd, binding.sdk_method)
        for k, v in query.items():
            if v is None:
                continue
            # cli.yml-injected defaults are per-OP, but a command can aggregate
            # multiple bindings (list + get); drop an injected default the selected
            # binding's method doesn't accept (e.g. sort/order on a get).
            if (query_flags[k].cli_default is not None
                    and accepted is not None and k not in accepted):
                continue
            kwargs[k] = _coerce(query_flags[k], v)
    except InputError as exc:
        _fail_input(exc)

    hooks = _hooks()
    # Filled by the call_api wrapper below; defined here so the except branch sees it.
    http_capture: dict[str, str] = {}
    try:
        if binding.body_model:
            models_mod = _models(cmd)
            extra: dict[str, Any] = {}
            if cmd.variant and cmd.variant_param:
                model_cls = getattr(models_mod, binding.body_model, None)
                fields = getattr(model_cls, "model_fields", {}) if model_cls else {}
                if cmd.variant_param in fields:
                    extra[cmd.variant_param] = cmd.variant
            kwargs[binding.body_param] = _build_body(
                binding, body, body_flags, models_mod, extra
            )
        if hooks and (pre := getattr(hooks, "before_call", None)) and callable(pre):
            kwargs = pre(binding.sdk_method, kwargs, cmd) or kwargs
        if dry_run:
            _dry_run(cmd, binding, kwargs)
            return
{%- if ir.connection_fields %}
        _preflight_connection(cmd)
{%- endif %}
        client = _client(verbose=verbose)
{%- if ir.credential_fields %}
        from . import auth_cache as _auth_cache
        _cache = _auth_cache.session(client)
        if _cache is not None:
            _cache.seed_if_valid()
{%- endif %}
        # Dispatch through the typed object wrapper. Federated: the composing client
        # exposes one handle per sub-package, so navigate `client.<sub>.<object>`;
        # single-spec (subpackage None) stays one level: `client.<object>`. Either
        # way `binding.sdk_method` is the wrapper's clean verb (e.g. `get`, `list`,
        # `create`), which translates `body`/enum params to the raw `*Api` surface.
        sub_client = getattr(client, cmd.subpackage) if cmd.subpackage else client
        api = getattr(sub_client, cmd.sdk_resource)
        method = getattr(api, binding.sdk_method)
        # Observe the actual outgoing request: every generated SDK method routes
        # through api_client.call_api(method, url, ...) with the query string
        # already appended to url. Wrap it at the (sub-)facade level (the wrappers
        # share one api_client) for the duration of the call (first invocation wins
        # under --all; restored in finally). Non-OAG clients (test fakes) lack the
        # shape -> fields simply absent.
        api_client = getattr(sub_client, "api_client", None)
        original_call = getattr(api_client, "call_api", None)
        if callable(original_call):
            def _capturing_call(*args: Any, **kw: Any) -> Any:
                if len(args) >= 2 and not http_capture:
                    http_capture["http_method"] = str(args[0])
                    http_capture["http_uri"] = str(args[1])
                return original_call(*args, **kw)
            api_client.call_api = _capturing_call
        started = time.monotonic()
        def _dispatch() -> Any:
            if binding.sub_verb == "list":
                # The wrapper list method paginates internally via `all_pages`;
