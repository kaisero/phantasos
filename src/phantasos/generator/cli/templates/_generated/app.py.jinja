"""Builds the generated Typer app. Compose it from a hand-owned entrypoint."""

from __future__ import annotations

import importlib.metadata as _metadata

import typer

{%- for resource in resources %}
from .commands import {{ resource }} as _cmd_{{ resource }}
{%- endfor %}
from . import cli_commands as _cli_commands
from . import config_commands as _config_commands
{%- if has_env %}
from . import environment_commands as _environment_commands
{%- endif %}

_DISTRIBUTION = "{{ distribution }}"


def _resolve_version() -> str:
    try:
        return _metadata.version(_DISTRIBUTION)
    except _metadata.PackageNotFoundError:
        return "unknown"


def _version_callback(value: bool | None) -> None:
    if value:
        typer.echo(f"{_DISTRIBUTION} {_resolve_version()}")
        raise typer.Exit()


_VERBS = ["create", "update", "delete", "show", "request"]

{% if federated -%}
# (key, verb, subpackage, typer_path, resource, func_name)
_REGISTRY = [
{%- for c in commands %}
    ({{ c.key|tojson }}, {{ c.verb|tojson }}, {{ c.subpackage|tojson }}, {{ c.typer_path|tojson }}, {{ c.sdk_resource|tojson }}, {{ c.func_name|tojson }}),
{%- endfor %}
]
{%- else -%}
# (key, verb, typer_path, resource, func_name)
_REGISTRY = [
{%- for c in commands %}
    ({{ c.key|tojson }}, {{ c.verb|tojson }}, {{ c.typer_path|tojson }}, {{ c.sdk_resource|tojson }}, {{ c.func_name|tojson }}),
{%- endfor %}
]
{%- endif %}


def build_generated_app(exclude: set[str] | None = None) -> typer.Typer:
    from . import logging_setup as _logging_setup

    _logging_setup.init_logging()
    exclude = exclude or set()
    app = typer.Typer(no_args_is_help=True)

    @app.callback()
    def _root(
        version: bool = typer.Option(
            None, "--version", callback=_version_callback, is_eager=True,
            help="Show the version and exit.",
        ),
    ) -> None:
        """{{ distribution }} — generated CLI."""

    verb_apps = {v: typer.Typer(no_args_is_help=True) for v in _VERBS}
    for v, t in verb_apps.items():
        app.add_typer(t, name=v)
    app.add_typer(_config_commands.config_app, name="config", rich_help_panel="CLI")
{%- if has_env %}
    app.add_typer(
        _environment_commands.environment_app,
        name="environment",
        rich_help_panel="CLI",
    )
{%- endif %}
    verb_apps["show"].add_typer(_cli_commands.cli_show_app, name="cli")
    resources = {
{%- for resource in resources %}
        {{ resource|tojson }}: _cmd_{{ resource }},
{%- endfor %}
    }
{%- if federated %}
    # N-level nesting: a `typer_path` is `[object]` (CRUD),
    # `[sub-package, object]` (federated CRUD) or `[sub-package, object, leaf]`
    # (a oneOf variant / request action). Intermediate sub-apps are keyed by
    # `(verb, *path[:depth])` so each level is created once and reused.
    object_apps: dict[tuple[str, ...], typer.Typer] = {}
    for key, verb, subpackage, path, resource, func_name in _REGISTRY:
        if key in exclude or verb not in verb_apps:
            continue
        fn = getattr(resources[resource], func_name)
        if len(path) == 1:
            verb_apps[verb].command(path[0])(fn)
        else:
            parent = verb_apps[verb]
            for depth in range(1, len(path)):
                prefix = (verb, *path[:depth])
                sub = object_apps.get(prefix)
                if sub is None:
                    sub = typer.Typer(no_args_is_help=True)
                    object_apps[prefix] = sub
                    parent.add_typer(sub, name=path[depth - 1])
                parent = sub
            parent.command(path[-1])(fn)
    return app
{%- else %}
    object_apps: dict[tuple[str, str], typer.Typer] = {}
    for key, verb, path, resource, func_name in _REGISTRY:
        if key in exclude or verb not in verb_apps:
            continue
        fn = getattr(resources[resource], func_name)
        if len(path) == 1:
            verb_apps[verb].command(path[0])(fn)
        else:  # len 2: object sub-Typer under the verb, leaf inside it
            obj, leaf = path
            sub = object_apps.get((verb, obj))
            if sub is None:
                sub = typer.Typer(no_args_is_help=True)
                object_apps[(verb, obj)] = sub
                verb_apps[verb].add_typer(sub, name=obj)
            sub.command(leaf)(fn)
    return app
{%- endif %}
