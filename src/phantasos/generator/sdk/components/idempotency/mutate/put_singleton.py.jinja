from __future__ import annotations

from typing import Any

from ..base import MUTATE


def put_singleton(res: Any, desired: Any, actual: Any, diff: Any, meta: dict) -> Any:
    # A singleton is a fixed-endpoint PUT: seed the full read-back, overlay the
    # user-set fields, and replace with NO id (the singleton has none — its
    # `replace` binding takes no `id` kwarg).
    merged = {**actual.to_dict(), **res._present(desired)}
    body = meta["models"]["update"].model_validate(merged)
    verb = getattr(res, meta["update"]["verb"])  # F9: "replace" for PUT
    return verb(body=body)


MUTATE["put_singleton"] = put_singleton
