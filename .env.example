# Prisma Browser SDK — live tenant credentials (TEMPLATE)
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# These are consumed by `prisma_browser_sdk.extras.client_from_env()`.
# `.env` is gitignored — never commit real secrets.

# --- OAuth2 client-credentials (from your Prisma SASE service account) ---
CLIENT_ID=
CLIENT_SECRET=

# Fully-formed OAuth scope. For Prisma SASE this is your Tenant Service Group ID
# prefixed with `tsg_id:` — e.g. SCOPE=tsg_id:1234567890
SCOPE=tsg_id:REPLACE_WITH_YOUR_TSG_ID

# --- Optional ---
# API base URL. Defaults to the production SASE API host if unset.
PRISMA_SASE_BASE_URL=https://api.sase.paloaltonetworks.com
